KIZUNA_ENVIRONMENT=development
KIZUNA_DATABASE_URL=sqlite:///./kizuna.db
KIZUNA_API_V1_PREFIX=/api/v1
KIZUNA_CORS_ORIGINS=http://localhost:8501,http://localhost:3000
KIZUNA_DEMO_MODE=true
KIZUNA_LOG_LEVEL=INFO
KIZUNA_MODEL_VERSION=kizuna-baseline-0.1.0
KIZUNA_FEATURE_VERSION=public-signals-0.1.0
KIZUNA_SCORING_VERSION=market-potential-0.1.0
KIZUNA_FRONTEND_MODE=auto
KIZUNA_API_URL=http://localhost:8000/api/v1

# ML layer (state model, /predict, reports)
KIZUNA_MODELS_DIR=models
KIZUNA_CSV_DIR=csv
KIZUNA_REPORTS_DIR=data/reports
KIZUNA_YOUTUBE_API_KEY=
KIZUNA_ANILIST_URL=https://graphql.anilist.co
KIZUNA_ANILIST_RAW_DIR=data/raw/anilist
KIZUNA_TRENDS_RAW_DIR=data/raw/google_trends
KIZUNA_TRENDS_ANCHOR=Death Note
