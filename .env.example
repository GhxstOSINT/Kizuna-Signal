KIZUNA_ENVIRONMENT=development
KIZUNA_DATABASE_URL=sqlite:///./kizuna.db
KIZUNA_API_V1_PREFIX=/api/v1
KIZUNA_CORS_ORIGINS=http://localhost:8501,http://localhost:3000
# true = every source is the deterministic offline demo; false = use live adapters where implemented
KIZUNA_DEMO_MODE=true
KIZUNA_SOURCE_TIMEOUT_SECONDS=10
KIZUNA_WIKIMEDIA_LOOKBACK_DAYS=90
# Google Trends via pytrends (unofficial, rate-limited): region, benchmark term, cache and 429 cool-down
KIZUNA_TRENDS_GEO=IN
KIZUNA_TRENDS_BENCHMARK=One Piece
KIZUNA_TRENDS_CACHE_TTL_SECONDS=21600
KIZUNA_TRENDS_COOLDOWN_SECONDS=900
# AniList GraphQL (no key; currently rate limited to 30 requests/minute by AniList)
KIZUNA_ANILIST_CACHE_TTL_SECONDS=86400
KIZUNA_ANILIST_COOLDOWN_SECONDS=60
# Folder of survey / viewing-behaviour CSVs (schema in data/survey/README.md)
KIZUNA_SURVEY_DIR=data/survey
# YouTube Data API v3 key (public data only). Without it the youtube source stays on demo data.
KIZUNA_YOUTUBE_API_KEY=
KIZUNA_LOG_LEVEL=INFO
KIZUNA_MODEL_VERSION=kizuna-baseline-0.1.0
KIZUNA_FEATURE_VERSION=public-signals-0.1.0
KIZUNA_SCORING_VERSION=market-potential-0.1.0

